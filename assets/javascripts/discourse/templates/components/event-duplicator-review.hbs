<table class="event-duplicator-review">
  <thead>
    <tr>
      <th></th>
      <th>{{i18n "event_duplicator.review.topic"}}</th>
      <th>{{i18n "event_duplicator.review.proposed_date"}}</th>
    </tr>
  </thead>
  <tbody>
    {{#each this.items as |item|}}
      <tr>
        <td>
          <input
            type="checkbox"
            checked={{item.isSelected}}
            {{on "change" (fn this.toggle item.topic.id)}}
          />
        </td>
        <td>{{item.topic.title}}</td>
        <td>{{item.topic.proposedStart}}</td>
      </tr>
    {{else}}
      <tr>
        <td colspan="3">{{i18n "event_duplicator.review.no_topics"}}</td>
      </tr>
    {{/each}}
  </tbody>
</table>

<DButton
  @class="btn-primary"
  @action={{this.confirm}}
  @disabled={{@isDuplicating}}
  @label="event_duplicator.review.confirm"
/>